{
  "lastChangelogVersion": "1.2.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "+grep",
    "+find",
    "+ls",
    "+powershell",
    "+codemode",
    "+tool_search"
  ],
  "packages": [
    "./local-packages/pi-ext-manifest-fix",
    "npm:pi-model-inherit",
    "npm:pi-private-models",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:@aliou/pi-guardrails",
    "npm:pi-markdown-preview",
    "npm:@heyhuynhgiabuu/pi-diff",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-multimodal-proxy",
    "npm:pi-intercom"
  ],
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "npmCommand": ["bun"],
  "theme": "dark"
}
