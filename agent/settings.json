{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultTools": ["+grep", "+powershell", "+codemode"],
  "packages": [
    "./local-packages/pi-ext-manifest-fix",
    "npm:pi-model-inherit",
    "npm:pi-private-models",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:@aliou/pi-guardrails",
    "npm:pi-markdown-preview",
    "npm:@heyhuynhgiabuu/pi-diff",
    {
      "source": "npm:pi-multimodal-proxy",
      "extensions": ["-extensions/vision-proxy.ts"]
    },
    "npm:pi-intercom"
  ],
  "defaultThinkingLevel": "high",
  "skills": ["!~/.agents/skills/**"],
  "npmCommand": ["bun"],
  "theme": "dark"
}

