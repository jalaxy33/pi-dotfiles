{
  "ignoreFields": [
    "lastChangelogVersion",
    "extensionChangelogVersions"
  ],
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultTools": [
    "+grep",
    "+find",
    "+codemode"
  ],
  "packages": [
    "npm:pi-model-inherit",
    "npm:pi-private-models",
    "npm:pi-web-access",
    "npm:@aliou/pi-guardrails",
    "npm:pi-markdown-preview",
    {
      "source": "npm:pi-multimodal-proxy",
      "extensions": [
        "-extensions/vision-proxy.ts"
      ]
    },
    "npm:pi-intercom",
    "npm:pi-context-view",
    "npm:pi-tps-meter",
    "git:https://gh-proxy.org/https://github.com/badlogic/pi-subagent.git"
  ],
  "defaultThinkingLevel": "high",
  "skills": [
    "!~/.agents/skills/**"
  ],
  "npmCommand": [
    "bun"
  ],
  "defaultProjectTrust": "always",
  "theme": "dark"
}