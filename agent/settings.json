{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultTools": ["+grep", "+find", "+codemode"],
  "packages": [
    "npm:pi-model-inherit",
    "npm:pi-private-models",
    "npm:pi-web-access",
    "npm:@aliou/pi-guardrails",
    "npm:pi-markdown-preview",
    {
      "source": "npm:pi-multimodal-proxy",
      "extensions": ["-extensions/vision-proxy.ts"]
    },
    "npm:pi-intercom",
    "./local-packages/pi-subagent-bootstrap"
  ],
  "defaultThinkingLevel": "high",
  "skills": ["!~/.agents/skills/**"],
  "npmCommand": ["bun"],
  "theme": "dark"
}
