{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.23.0/schema.json",
  "permissionGate": {
    "patterns": [
      {
        "pattern": "(?:^|[;&|])\\s*git\\s+(add|commit)",
        "description": "Add or commit changes",
        "regex": true
      },
      { "pattern": "(?:^|[;&|])\\s*git\\s+push", "description": "Push changes", "regex": true },
      { "pattern": "(?:^|[;&|])\\s*git\\s+merge", "description": "Merge branches", "regex": true },
      {
        "pattern": "(?:^|[;&|])\\s*git\\s+.*reset\\s.*--hard",
        "description": "Discard uncommitted work",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*git\\s+(checkout|restore)\\s+(--\\s|\\.(\\s|$)|-f\\b|--force)",
        "description": "Discard local changes",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*git\\s+(branch\\s+-D|tag\\s+-d|stash\\s+(drop|clear)|worktree\\s+remove)",
        "description": "Delete branch, tag or stash",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*git\\s+clean\\s.*(-[a-zA-Z]*[fdx]|--force)",
        "description": "Delete untracked files",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*rsync\\s.*--delete",
        "description": "Delete destination files",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*((find|ls|git\\s+ls-files)\\s.*(-delete|-exec\\s+rm)|xargs\\s.*\\brm)",
        "description": "Bulk delete files",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*rm\\s+(-[a-zA-Z]*r|--recursive)",
        "description": "Recursive delete",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*truncate\\s+(-s\\s*0|--size=0)",
        "description": "Truncate file",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*(dropdb|mysqladmin\\s.*drop|redis-cli\\s.*(flush|FLUSH)|mongosh?\\s.*dropDatabase)",
        "description": "Drop or flush a database",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*[\\w./-]+\\s+(-c|--command|-e|--eval)\\s+['\"]?\\s*([Dd][Rr][Oo][Pp]|[Tt][Rr][Uu][Nn][Cc][Aa][Tt][Ee])\\s+([Dd][Aa][Tt][Aa][Bb][Aa][Ss][Ee]|[Tt][Aa][Bb][Ll][Ee]|[Ss][Cc][Hh][Ee][Mm][Aa]|[Kk][Ee][Yy][Ss][Pp][Aa][Cc][Ee])",
        "description": "SQL drop or truncate",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*(terraform\\s+(apply|destroy|state\\s+rm)|kubectl\\s+(delete|drain)|helm\\s+(uninstall|delete))",
        "description": "Destroy infrastructure",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*docker\\s+(system\\s+prune|volume\\s+(rm|prune)|compose\\s+down\\s.*-v)",
        "description": "Remove volumes or prune",
        "regex": true
      },
      {
        "pattern": "(?:^|[;&|])\\s*((npm|pnpm|yarn)\\s+(publish|unpublish)|cargo\\s+publish|gem\\s+push|gh\\s+(release|repo)\\s+delete)",
        "description": "Publish or delete release",
        "regex": true
      }
    ],
    "autoDenyPatterns": [
      {
        "pattern": "(?:^|[;&|])\\s*git\\s+(filter-branch|filter-repo|update-ref\\s+-d|reflog\\s+(expire|delete)|gc\\s.*--prune=(now|0|all|never))",
        "description": "Destroys git recovery path",
        "regex": true
      }
    ]
  },
  "version": "0.23.0"
}
