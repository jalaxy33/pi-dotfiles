#!/bin/sh
# Rejects lazy commit messages: banned openers, one-word subjects, overlong
# subjects, trailing periods, multi-line bodies.
# Enabled per clone with: git config core.hooksPath .githooks

max_length=72
banned='update|updates|updaye|daily|wip|minor|misc|stuff|various|tweak|tweaks|edit|edits|small|some|change|changes|more'

message=$1
subject=$(sed -e '/^#/d' "$message" | awk 'NF { print; exit }')
body_lines=$(sed -e '/^#/d' "$message" | awk 'NF' | wc -l | tr -d ' ')

# Merge commits are written by git itself.
case "$subject" in
  "Merge "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "" >&2
  printf '%s\n' "say what changed, in one line:" \
    "  add pi-intercom" \
    "  bump guardrails to 0.19.0" \
    "  ignore volatile settings fields" >&2
  exit 1
}

[ -n "$subject" ] || fail "empty commit message"
[ "$body_lines" -le 1 ] || fail "keep the message to a single line"

printf '%s' "$subject" | grep -qE "^($banned)( |:|,|$)" &&
  fail "'$(printf '%s' "$subject" | awk '{print $1}' | tr -d ':')' says nothing about the change"

[ "$(printf '%s' "$subject" | wc -w | tr -d ' ')" -ge 2 ] ||
  fail "one word is not a description"

printf '%s' "$subject" | grep -qE '^[a-z]' || fail "start with a lowercase word"
[ ${#subject} -le $max_length ] || fail "subject is ${#subject} characters, max is $max_length"
printf '%s' "$subject" | grep -q '\.$' && fail "drop the trailing period"

exit 0
