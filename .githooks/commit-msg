#!/bin/sh
# Rejects lazy commit messages: vague openers, one-word subjects, subjects over
# 72 characters, trailing periods, multi-line bodies.
# Enabled per clone with: git config core.hooksPath .githooks

max_length=72
vague_words='update updates updaye daily wip minor misc stuff various tweak tweaks edit edits small some change changes more'

# `git commit -v` appends the diff under a scissors line; drop it and the comments.
message=$(awk '/^# -+ >8 -+$/ { exit } /^#/ { next } NF' "$1")
subject=$(printf '%s\n' "$message" | head -1 | sed 's/[[:space:]]*$//')
body=$(printf '%s\n' "$message" | tail -n +2)

# Merge commits are written by git itself.
case "$subject" in
  "Merge "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "" >&2
  printf '%s\n' "say what changed, in one line:" \
    "  add pi-intercom" \
    "  bump guardrails to 0.19.0" \
    "  ignore volatile settings fields" >&2
  exit 1
}

[ -n "$subject" ] || fail "empty commit message"
[ -z "$body" ] || fail "keep the message to a single line"

opener=$(printf '%s' "$subject" | awk '{print tolower($1)}' | tr -d ':,.!')
case " $vague_words " in
  *" $opener "*) fail "'$opener' says nothing about the change" ;;
esac

[ "$(printf '%s' "$subject" | wc -w | tr -d ' ')" -ge 2 ] ||
  fail "one word is not a description"

[ ${#subject} -le $max_length ] || fail "subject is ${#subject} characters, max is $max_length"

case "$subject" in
  *.) fail "drop the trailing period" ;;
esac

exit 0
