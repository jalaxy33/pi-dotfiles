{
  "workflow": "none",
  "searchRouting": {
    "providers": ["tavily", "firecrawl", "anysearch", "degoog"],
    "fallbackOn": [
      "transient",
      "quota",
      "network",
      "invalid-response",
      "unsupported"
    ]
  },
  "firecrawlBaseUrl": "https://api.firecrawl.dev",
  "firecrawlApiKey": "$FIRECRAWL_API_KEY"
}
