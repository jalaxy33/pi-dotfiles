{
  "workflow": "none",
  "searchRouting": {
    "providers": ["firecrawl", "tavily", "deepseek"],
    "fallbackOn": [
      "transient",
      "quota",
      "network",
      "invalid-response",
      "unsupported"
    ]
  },
  "firecrawlBaseUrl": "https://api.firecrawl.dev",
  "firecrawlApiKey": "$FIRECRAWL_API_KEY",
  "ssrf": {
    "allowRanges": ["198.18.0.0/15"]
  }
}
